# Veřejná URL bez koncového lomítka
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Na Vercelu nastavte APP_ENV=production; teprve pak se striktně vyžadují všechna tajemství.
APP_ENV=local
DEFAULT_CITY_SLUG=brno
NEXT_PUBLIC_DEFAULT_CITY_SLUG=brno
MULTI_CITY_ENABLED=false
NEXT_PUBLIC_MULTI_CITY_ENABLED=false
# Čárkami oddělená serverová allowlist publikovaných měst pro časnou HTTP 404 kontrolu
PUBLISHED_CITY_SLUGS=brno
NEXT_PUBLIC_CONTACT_EMAIL=ahoj@studenthub-brno.cz
NEXT_PUBLIC_PARTNER_EMAIL=partneri@studenthub-brno.cz

# Supabase: URL a anon klíč smějí do klienta; service role je výhradně serverové tajemství
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Produkční bezpečnost
CRON_SECRET=
RATE_LIMIT_SALT=
SYNC_USER_AGENT=StudentHub-Brno/1.0 (+https://studenthub-brno.cz/kontakt)

# Produkční výchozí hodnoty: žádná lokální data ani fallback
DEMO_MODE=false
ALLOW_LOCAL_FILE_STORE=false
ALLOW_VERIFIED_FALLBACK=false
ADMIN_DEMO_PASSWORD=
ADMIN_COOKIE_SECRET=

# Reklamy a externí feedy jsou ve výchozím stavu vypnuté
NEXT_PUBLIC_ADS_ENABLED=false
FAJN_BRIGADY_FEED_ENABLED=false
FAJN_BRIGADY_FEED_URL=
